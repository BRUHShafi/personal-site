# Copy to .env and fill in. .env is gitignored — never commit the real values.
#
# STEAM_KEY: https://steamcommunity.com/dev/apikey
#   Treat it like a password. It grants read access to your Steam account data.
#   Revoke/regenerate on that same page if it ever leaks.
STEAM_KEY=
#
# STEAM_ID: your 17-digit SteamID64 (not your vanity URL name).
#   Find it at steamid.io, or via the ResolveVanityURL endpoint.
STEAM_ID=
